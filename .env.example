# PostgreSQL / PostGIS
POSTGRES_DB=smartmotel
POSTGRES_USER=smartmotel
POSTGRES_PASSWORD=smartmotel_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartmotel:smartmotel_dev_password@localhost:5432/smartmotel?schema=public

# API / Web
API_PORT=4000
WEB_PORT=3001
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Firebase Web SDK (Firebase Console > Project settings > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (Firebase Console > Project settings > Service accounts)
# Keep these ONLY on the backend. Never expose them with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Put the PEM key on one line and keep \n escape sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
