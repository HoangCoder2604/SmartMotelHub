# Local Docker values remain optional for local development.
POSTGRES_DB=smartmotel
POSTGRES_USER=smartmotel
POSTGRES_PASSWORD=smartmotel_dev_password
POSTGRES_PORT=5432

# Supabase / Prisma
DATABASE_URL=postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=2

# API / Web
API_PORT=4000
# Phase 13: contract expiry worker (default 1 hour, minimum 5 minutes)
CONTRACT_EXPIRY_CHECK_INTERVAL_MS=3600000
# Optional but recommended for serverless production cron endpoint
CRON_SECRET=
WEB_PORT=3001
WEB_ORIGIN=http://localhost:3001,https://YOUR-WEB-PROJECT.vercel.app
NEXT_PUBLIC_API_URL=https://YOUR-API-PROJECT.vercel.app/api/v1

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Supabase Storage (backend only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images

# VNPAY Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://YOUR-API-PROJECT.vercel.app/api/v1/payments/vnpay/return
VNPAY_WEB_RESULT_URL=https://YOUR-WEB-PROJECT.vercel.app/payments/result
VNPAY_ORDER_TYPE=other
VNPAY_EXPIRE_MINUTES=15
VNPAY_IPN_URL=https://YOUR-API-PROJECT.vercel.app/api/v1/payments/vnpay/ipn
